{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://document-synthesis.org/schemas/role-map-v1.json",
  "title": "Document Synthesis Role Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mapping_schema_version", "source_sha256", "source_file", "analyzer_version", "assignments", "on_unmapped"],
  "properties": {
    "mapping_schema_version": {"type": "integer", "const": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "source_file": {"type": "string", "minLength": 1},
    "analyzer_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+.*$"},
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": ["node_ref", "role", "provenance", "confirmed"],
          "properties": {
          "node_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_sha256", "part_uri", "element_path", "text_hash"],
            "properties": {
              "source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
              "part_uri": {"type": "string", "minLength": 1},
              "element_path": {"type": "string", "minLength": 1},
              "text_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
            }
          },
          "role": {"type": "string", "minLength": 1},
          "provenance": {"type": "string", "minLength": 1},
          "confirmed": {"type": "boolean"},
          "level": {"type": ["integer", "null"], "minimum": 1, "maximum": 9},
          "bookmark_name": {"type": ["string", "null"]},
          "story_type": {"type": "string", "minLength": 1}
        }
      }
    },
    "on_unmapped": {"type": "string", "enum": ["preserve", "error"]}
  }
}
