# Set default behavior to automatically handle line endings and enforce LF
* text=auto eol=lf

# Explicit LF enforcement for text files
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files that must never have line ending normalization applied
*.docx binary
*.doc binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.pptx binary
