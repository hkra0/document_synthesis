{
  "format_schema_version": 1,
  "id": "academic-basic",
  "version": "1.0.0",
  "metadata": {
    "description": "基础学术论文排版规范预设",
    "institution": "学术通用标准"
  },
  "page": {
    "width_mm": 210.0,
    "height_mm": 297.0,
    "orientation": "portrait",
    "margin_top_mm": 25.0,
    "margin_bottom_mm": 25.0,
    "margin_left_mm": 25.0,
    "margin_right_mm": 25.0,
    "header_distance_mm": 15.0,
    "footer_distance_mm": 15.0,
    "snap_to_grid": true
  },
  "styles": {
    "body": {
      "run": {
        "east_asia": "宋体",
        "latin": "Times New Roman",
        "size_pt": 12.0,
        "bold": false,
        "italic": false,
        "color": "auto"
      },
      "paragraph": {
        "alignment": "justify",
        "first_line_indent": { "value": 2.0, "unit": "char" },
        "space_before_pt": 0.0,
        "space_after_pt": 0.0,
        "line_spacing": { "mode": "multiple", "value": 1.5 },
        "widow_control": true
      }
    },
    "title": {
      "run": {
        "east_asia": "黑体",
        "latin": "Times New Roman",
        "size_pt": 22.0,
        "bold": true
      },
      "paragraph": {
        "alignment": "center",
        "space_before_pt": 18.0,
        "space_after_pt": 18.0,
        "keep_with_next": true
      }
    },
    "subtitle": {
      "run": {
        "east_asia": "楷体_GB2312",
        "latin": "Times New Roman",
        "size_pt": 14.0,
        "bold": false
      },
      "paragraph": {
        "alignment": "center",
        "space_before_pt": 6.0,
        "space_after_pt": 12.0,
        "keep_with_next": true
      }
