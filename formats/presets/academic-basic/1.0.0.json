    "heading.1": {
      "based_on": "body",
      "run": {
        "east_asia": "黑体",
        "latin": "Times New Roman",
        "size_pt": 16.0,
        "bold": true
      },
      "paragraph": {
        "alignment": "left",
        "space_before_pt": 12.0,
        "space_after_pt": 6.0,
        "keep_with_next": true,
        "page_break_before": true,
        "first_line_indent": { "value": 0.0, "unit": "char" }
      }
    },
    "heading.2": {
      "based_on": "body",
      "run": {
        "east_asia": "黑体",
        "latin": "Times New Roman",
        "size_pt": 14.0,
        "bold": true
      },
      "paragraph": {
        "alignment": "left",
        "space_before_pt": 8.0,
        "space_after_pt": 4.0,
        "keep_with_next": true,
        "first_line_indent": { "value": 0.0, "unit": "char" }
      }
    },
    "heading.3": {
      "based_on": "body",
      "run": {
        "east_asia": "黑体",
        "latin": "Times New Roman",
        "size_pt": 12.0,
        "bold": true
      },
      "paragraph": {
        "alignment": "left",
        "space_before_pt": 6.0,
        "space_after_pt": 2.0,
        "keep_with_next": true,
        "first_line_indent": { "value": 0.0, "unit": "char" }
      }
    },
    "heading.4": { "based_on": "body" },
    "heading.5": { "based_on": "body" },
    "heading.6": { "based_on": "body" },
    "heading.7": { "based_on": "body" },
    "heading.8": { "based_on": "body" },
    "heading.9": { "based_on": "body" },
    "toc.title": {
      "run": {
        "east_asia": "黑体",
        "latin": "Times New Roman",
        "size_pt": 18.0,
        "bold": true
      },
      "paragraph": {
        "alignment": "center",
        "space_before_pt": 12.0,
        "space_after_pt": 12.0
      }
    },
    "toc.1": { "based_on": "body" },
    "toc.2": { "based_on": "body" },
    "toc.3": { "based_on": "body" },
    "toc.4": { "based_on": "body" },
    "toc.5": { "based_on": "body" },
    "toc.6": { "based_on": "body" },
    "toc.7": { "based_on": "body" },
    "toc.8": { "based_on": "body" },
    "toc.9": { "based_on": "body" },
    "header": {
      "run": { "east_asia": "宋体", "latin": "Times New Roman", "size_pt": 9.0 },
      "paragraph": { "alignment": "center" }
    },
    "footer": {
      "run": { "east_asia": "宋体", "latin": "Times New Roman", "size_pt": 9.0 },
      "paragraph": { "alignment": "center" }
    },
    "table.body": {
      "based_on": "body",
      "run": { "size_pt": 10.5 },
      "paragraph": {
        "first_line_indent": { "value": 0.0, "unit": "char" },
        "line_spacing": { "mode": "multiple", "value": 1.2 }
      }
    },
    "caption": {
      "run": { "east_asia": "宋体", "latin": "Times New Roman", "size_pt": 10.5 },
      "paragraph": {
        "alignment": "center",
        "space_before_pt": 4.0,
        "space_after_pt": 4.0
      }
    },
    "quote": {
      "based_on": "body",
      "paragraph": { "left_indent": { "value": 2.0, "unit": "char" } }
    },
    "bibliography": {
      "based_on": "body",
      "run": { "size_pt": 10.5 },
      "paragraph": {
        "first_line_indent": { "value": 0.0, "unit": "char" },
        "line_spacing": { "mode": "multiple", "value": 1.2 }
      }
    }
  },
  "roles": {
    "body": { "style": "body", "include_in_toc": false },
    "title": { "style": "title", "include_in_toc": false },
    "subtitle": { "style": "subtitle", "include_in_toc": false },
    "heading.1": { "style": "heading.1", "outline_level": 1, "include_in_toc": true },
    "heading.2": { "style": "heading.2", "outline_level": 2, "include_in_toc": true },
    "heading.3": { "style": "heading.3", "outline_level": 3, "include_in_toc": true },
    "heading.4": { "style": "heading.4", "outline_level": 4, "include_in_toc": true },
    "heading.5": { "style": "heading.5", "outline_level": 5, "include_in_toc": true },
    "heading.6": { "style": "heading.6", "outline_level": 6, "include_in_toc": true },
    "heading.7": { "style": "heading.7", "outline_level": 7, "include_in_toc": true },
    "heading.8": { "style": "heading.8", "outline_level": 8, "include_in_toc": true },
    "heading.9": { "style": "heading.9", "outline_level": 9, "include_in_toc": true },
    "toc.title": { "style": "toc.title", "include_in_toc": false },
    "caption": { "style": "caption", "include_in_toc": false },
    "table.body": { "style": "table.body", "include_in_toc": false },
    "quote": { "style": "quote", "include_in_toc": false },
    "bibliography": { "style": "bibliography", "include_in_toc": false }
  },
  "toc": {
    "title": "目  录",
    "title_role": "toc.title",
    "max_level": 3,
    "leader": "dots",
    "page_number_gap_mm": 5.0
  },
  "footer": {
    "mode": "managed",
    "format": "number",
    "alignment": "center",
    "style": "footer"
  },
  "required_capabilities": [
    "styles.paragraph.v1",
    "styles.character.v1",
    "layout.single_column.v1",
    "docx.single_source_preservation.v1"
  ]
